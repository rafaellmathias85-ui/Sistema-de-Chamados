# ========== CONFIGURAÇÃO DO BANCO DE DADOS ==========
# Substitua pela URL do PostgreSQL no seu VPS
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/winner_helpdesk?schema=public"

# ========== NEXTAUTH ==========
NEXTAUTH_SECRET="gere-uma-chave-secreta-aleatoria"
