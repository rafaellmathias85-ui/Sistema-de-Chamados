generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ============================================================
// MULTI-TENANCY (SaaS)
// ============================================================

enum TenantPlan {
  BASIC
  PRO
  ENTERPRISE
}

model Tenant {
  id         String     @id @default(cuid())
  name       String
  domain     String?    @unique // subdomínio ou domínio personalizado
  planType   TenantPlan @default(BASIC)
  isActive   Boolean    @default(true)
  settingsJson String?  // JSON com configurações do tenant
  
  // Logo e branding
  logoUrl    String?
  primaryColor String?  @default("#3B82F6")
  
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  
  // Relações
  users       User[]
  companies   Company[]
  tickets     Ticket[]
  categories  Category[]
  slaConfigs  SLAConfig[]
  rmmMachines RmmMachine[]
  rmmAlertPolicies RmmAlertPolicy[]
  rmmScripts  RmmScript[]
  rmmPlaybooks RmmPlaybook[]
  kbCategories KBCategory[]
  kbArticles  KBArticle[]
  appointments Appointment[]
  emailConfigs EmailConfig[]
  whatsappIntegrations WhatsAppIntegration[]
  whatsappLogs WhatsAppLog[]
  snmpDevices  SnmpDevice[]
  rmmInstallers RmmInstaller[]
  
  // RMM v2 - Governance relations
  agentVersions         AgentVersion[]
  usbPolicies           UsbPolicy[]
  productivityPolicies  ProductivityPolicy[]
  webFilterCategories   WebFilterCategory[]
  webFilterPolicies     WebFilterPolicy[]
  relayCredentials      RelayCredential[]
}

enum Role {
  ADMIN
  SUPPORT
  CLIENT
  FINANCE
  SPECIAL
}

// TicketStatus: migrado de enum para String em v10 (Item 4 - Opção A)
// Permite status totalmente personalizáveis via /tickets/admin/statuses
// Valores padrão: OPEN, IN_PROGRESS, IN_PARTNER, PAUSED, AWAITING_CLIENT, RESOLVED, CLOSED

enum ClientType {
  CONTRATO
  AVULSO
  PROJETO
  PARCEIRO
}

enum KBVisibility {
  PRIVATE   // Só o criador vê
  SHARED    // Todos do suporte/admin veem
}

enum TicketPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Categorias de chamados (suporta subcategorias)
model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#3B82F6")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Multi-tenancy
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  
  // Relação hierárquica (categoria pai)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  
  tickets     Ticket[]
  
  @@unique([name, parentId])
  @@index([tenantId])
}

// Configuração de SLA por prioridade
model SLAConfig {
  id              String         @id @default(cuid())
  priority        TicketPriority @unique
  responseTimeHrs Int            // Tempo para primeira resposta em horas
  resolutionHrs   Int            // Tempo para resolução em horas
  
  // Multi-tenancy
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  @@index([tenantId])
}

// Anexos de chamados
model TicketAttachment {
  id             String   @id @default(cuid())
  fileName       String
  fileSize       Int
  fileType       String
  cloudStoragePath String
  isPublic       Boolean  @default(false)
  
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  uploadedById   String
  uploadedByName String
  
  createdAt      DateTime @default(now())
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(CLIENT)
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  
  // Multi-tenancy
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // MFA TOTP
  mfaEnabled      Boolean  @default(false)
  mfaSecret       String?  // Encrypted TOTP secret
  mfaBackupCodes  String?  // JSON array of hashed backup codes
  mfaEnforced     Boolean  @default(false) // Admin forced MFA
  mfaVerifiedAt   DateTime? // Last MFA verification
  mfaFailedAttempts Int    @default(0)
  mfaLockedUntil  DateTime?
  
  // Permissões granulares para perfil SPECIAL (JSON array de menus permitidos)
  allowedMenus    String?   // Ex: '["dashboard","tickets","ai-chat"]'
  
  // Tickets criados pelo usuário
  ticketsCreated  Ticket[]  @relation("TicketCreator")
  // Tickets atribuídos ao usuário (suporte)
  ticketsAssigned Ticket[]  @relation("TicketAssignee")
  // Conversas IA
  aiConversations AiConversation[]
  mfaAuditLogs    MfaAuditLog[]
  passwordResetTokens PasswordResetToken[]
  
  // Transferências de chamados
  transfersAsCurrentResponsible  TicketTransferRequest[] @relation("TransferCurrentResponsible")
  transfersAsNewResponsible      TicketTransferRequest[] @relation("TransferNewResponsible")
  transfersRequested             TicketTransferRequest[] @relation("TransferRequestedBy")
  transfersProcessed             TicketTransferRequest[] @relation("TransferProcessedBy")
  
  @@index([tenantId])
  @@index([email])
  @@index([role])
  @@index([companyId])
}

// Configurações globais do sistema
model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}

// Configuração de provedores de IA (built-in + custom)
// - Provedores built-in (AbacusAI, OpenAI, Gemini): podem ser editados (priority/weight/enabled) mas não removidos.
//   Eles continuam usando a env var declarada em apiKeyEnv.
// - Provedores custom (Claude, etc.): admin os adiciona via UI; apiKey é armazenado criptografado em apiKeyEnc.
model AIProviderConfig {
  id          String   @id @default(cuid())
  name        String   @unique // ex: "AbacusAI", "OpenAI", "Anthropic Claude"
  endpoint    String   // ex: "https://api.anthropic.com/v1/messages"
  model       String   // ex: "claude-3-5-sonnet-20241022"
  apiKeyEnv   String?  // só para built-ins; lê do process.env
  apiKeyEnc   String?  // só para custom; criptografado em AES-256-GCM via MFA_ENCRYPTION_KEY
  priority    Int      @default(99)
  weight      Int      @default(1)
  enabled     Boolean  @default(true)
  bestFor     String   @default("general") // CSV: "fast,creative,complex,general"
  isCustom    Boolean  @default(true)
  // Formato de API: "openai_compatible" (default) | "anthropic" | "custom"
  apiFormat   String   @default("openai_compatible")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([priority])
  @@index([enabled])
}

// Log de auditoria MFA
model MfaAuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // mfa_setup, mfa_enabled, mfa_disabled, mfa_reset, mfa_verify_success, mfa_verify_fail, mfa_backup_used, mfa_locked
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())
  
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   // 6-digit code
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([code, userId])
}

model Company {
  id             String     @id @default(cuid())
  name           String
  cnpj           String?    @unique
  phone          String?
  email          String?
  domain         String?    @unique // Domínio da empresa (ex: mandusocial.org)
  clientType     ClientType @default(CONTRATO) // Contrato, Avulso ou Projeto
  needsAttention Boolean    @default(false) // Empresa criada automaticamente, precisa completar cadastro
  rmmToken       String?    @unique // Token exclusivo para agente RMM
  
  // Multi-tenancy
  tenantId       String?
  tenant         Tenant?    @relation(fields: [tenantId], references: [id])
  
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  
  users       User[]
  tickets     Ticket[]
  rmmMachines RmmMachine[]
  snmpDevices SnmpDevice[]
  rmmInstallers RmmInstaller[]
  quotes      Quote[]
  
  // RMM v2 - Governance relations
  usbPolicies           UsbPolicy[]
  productivityPolicies  ProductivityPolicy[]
  webFilterPolicies     WebFilterPolicy[]
  relayCredentials      RelayCredential[]
  relayConfigs          RelayConfig[]
  relayDiscoveredMachines RelayDiscoveredMachine[]
  
  @@index([tenantId])
  @@index([name])
}

// === RMM (Remote Monitoring and Management) ===

// Pacote de instalacao MSI (ou outro arquivo) versionado, por empresa.
// O MSI e gerado externamente em ambiente Windows (WiX + signtool) e
// apenas distribuido por aqui via download autenticado por token.
model RmmInstaller {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Metadados do pacote
  fileName      String   // nome original (ex: WinnerRMM-acme-1.0.3.msi)
  version       String   // SemVer ou string livre (ex: 1.0.3)
  packageType   String   @default("msi") // msi | exe | zip | ps1
  changelog     String?  // notas de release
  // Storage S3
  cloudStoragePath String // chave do objeto no bucket
  fileSize         Int    // tamanho em bytes
  sha256           String? // hash do arquivo para verificacao de integridade
  // Distribuicao
  downloadToken String   @unique // token para link publico de download
  active        Boolean  @default(true) // false = arquivado
  downloadCount Int      @default(0)
  lastDownloadAt DateTime?
  // Auditoria
  uploadedById  String
  uploadedByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([companyId])
  @@index([active])
  @@index([tenantId])
}


enum RmmTaskStatus {
  PENDING
  RUNNING
  EXECUTED
  ERROR
  CANCELLED
}

model RmmMachine {
  id          String    @id @default(cuid())
  hostname    String
  username    String?   // Usuário logado
  os          String?   // Sistema operacional
  ram         String?   // Ex: "16 GB"
  diskModel   String?   // Modelo do disco
  diskSize    String?   // Ex: "500 GB"
  status      String    @default("Offline") // Ligado, Offline
  lastLogin   String?   // Último login do SO
  lastCheckin DateTime? // Último contato com o servidor
  ipAddress   String?   // IP da máquina
  
  // Extended RMM data
  publicIp      String?   // IP público (externo)
  upnUsers      String?   // JSON array of UPN users logged
  gpuInfo       String?   // GPU model info
  services      String?   // JSON array of running services
  installedApps String?   // JSON array of installed applications
  cpuModel      String?   // CPU model
  cpuUsage      Float?    // Current CPU usage %
  ramUsage      Float?    // Current RAM usage %
  diskUsage     Float?    // Current disk usage %
  antivirusStatus String? // Antivirus status
  lastBootTime  DateTime? // Last boot/restart time
  teamviewerId  String?   // TeamViewer Host ID
  
  // Hardware extras
  serialNumber       String? // Serial number da maquina (BIOS)
  manufacturer       String? // Fabricante (ex: Dell, HP, Lenovo)
  model              String? // Modelo do hardware
  memorySlotsTotal   Int?    // Total de slots de memoria RAM
  memorySlotsUsed    Int?    // Slots de memoria preenchidos
  memoryModulesJson  String? // JSON [{capacity, speed, manufacturer, slot}]
  
  // Network
  macAddress      String?   // MAC address da placa de rede principal

  // RMM v2 - Agent Version Control (migração SQL executada no VPS)
  agentVersion    String?
  agentType       String?   @default("ps1")
  lastUpdateAt    DateTime?
  updateChannel   String?   @default("stable")
  
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Multi-tenancy
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  
  tasks              RmmTask[]
  alerts             RmmAlert[]
  snapshots          MachineSnapshot[]
  execLogs           RmmExecLog[]
  securityEvents     SecurityEvent[]
  securityAlerts     SecurityAlert[]
  playbookExecutions PlaybookExecution[]
  watchedDevices     SnmpDevice[] @relation("DeviceWatcher")
  
  // RMM v2 - Governance relations
  agentUpdateHistory    AgentUpdateHistory[]
  activitySessions      EndpointActivitySession[]
  webActivities         WebActivity[]
  usbEvents             UsbEvent[]
  driverInventory       DriverInventory[]
  driverUpdateJobs      DriverUpdateJob[]
  webFilterLogs         WebFilterLog[]
  relayDiscoveries      RelayDiscoveredMachine[] @relation("RelayScanner")
  relayDiscoveredAs     RelayDiscoveredMachine[] @relation("DiscoveredAgent")
  relayConfig           RelayConfig?
  relayDeploymentJobs   RelayDeploymentJob[]
  
  // RMM v2 - Disk Health relations
  diskInventoryItems    DiskInventory[]
  diskHealthMetrics     DiskHealthMetric[]
  diskHealthAlerts      DiskHealthAlert[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([hostname, companyId])
  @@index([tenantId])
}

// Snapshots de métricas da máquina (processos, serviços, apps)
model MachineSnapshot {
  id              String   @id @default(cuid())
  machineId       String
  machine         RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  
  cpuPercent      Float?
  memoryPercent   Float?
  memoryUsedBytes BigInt?
  diskUsageJson   String?  // JSON [{mount, usedBytes, freeBytes, totalBytes, percent}]
  processesJson   String?  // JSON [{pid, name, cpu, mem, path, user}]
  servicesJson    String?  // JSON [{name, status, startType, displayName}]
  installedAppsJson String? // JSON [{name, version, publisher}]
  startupAppsJson String?  // JSON [{name, command, location}]
  gpuJson         String?  // JSON [{name, utilization, memoryTotal, memoryUsed}]
  networkIoJson   String?  // JSON [{interface, bytesIn, bytesOut, speed}]
  
  createdAt       DateTime @default(now())
  
  @@index([machineId, createdAt])
}

// Script aprovação para execução remota
model RmmScript {
  id          String   @id @default(cuid())
  name        String
  description String?
  scriptType  String   // bat, vbs, ps1
  content     String   // Conteúdo do script
  contentHash String?  // SHA256 hash
  sizeBytes   Int?
  approved    Boolean  @default(false)
  approvedBy  String?
  approvedByName String?
  approvedAt  DateTime?
  createdBy   String
  createdByName String
  companyId   String?  // null = global
  
  // Multi-tenancy
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  
  execLogs    RmmExecLog[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
}

// Log de execução remota de scripts
model RmmExecLog {
  id          String   @id @default(cuid())
  machineId   String
  machine     RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  scriptId    String
  script      RmmScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  
  requestedBy String
  requestedByName String
  requestTime DateTime @default(now())
  
  approvedBy  String?
  approvedAt  DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  exitCode    Int?
  stdout      String?
  stderr      String?
  status      String   @default("PENDING") // PENDING, APPROVED, RUNNING, SUCCESS, FAILED, TIMEOUT, REJECTED
  
  createdAt   DateTime @default(now())
  
  @@index([machineId, createdAt])
}

// Políticas de alerta RMM configuráveis por empresa
model RmmAlertPolicy {
  id          String   @id @default(cuid())
  name        String
  companyId   String?  // null = policy padrão global
  
  cpuThreshold    Float?   // % CPU para alerta
  ramThreshold    Float?   // % RAM para alerta
  diskThreshold   Float?   // % Disk para alerta
  offlineMinutes  Int?     // Minutos offline para alerta
  
  autoRemediationScriptId String? // Script para executar automaticamente
  
  // Multi-tenancy
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  
  enabled     Boolean  @default(true)
  createdBy   String?
  createdByName String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
}

// Alertas gerados pelo RMM
model RmmAlert {
  id          String   @id @default(cuid())
  machineId   String
  machine     RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  
  policyId    String?  // Política que gerou o alerta
  alertType   String   // cpu_high, ram_high, disk_high, offline, service_stopped
  message     String
  severity    String   @default("warning") // info, warning, critical
  thresholdValue Float?
  actualValue    Float?
  acknowledged Boolean @default(false)
  acknowledgedBy String?
  acknowledgedByName String?
  acknowledgedAt DateTime?
  resolvedAt  DateTime? // Auto-resolução (ex: offline → online)
  
  // Ação pós-reconhecimento
  actionTaken   String?   // 'closed' ou 'ticket_created'
  ticketId      String?   // Ticket criado a partir do alerta
  
  createdAt   DateTime @default(now())
  
  @@index([machineId, createdAt])
  @@index([machineId, alertType, acknowledged]) // Dedup index
}

model RmmTask {
  id        String        @id @default(cuid())
  command   String        // Comando PowerShell/CMD
  scriptType String?      // Tipo de script: powershell, cmd, vbscript, python, auto
  status    RmmTaskStatus @default(PENDING)
  result    String?       @db.Text // Saída do comando (final)
  liveOutput String?      @db.Text // Saída em tempo real (incremental, durante execução)
  startedAt  DateTime?    // Quando o agente iniciou a execução
  
  machineId String
  machine   RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  
  createdBy   String?   // ID do usuário que criou
  createdByName String? // Nome do usuário
  
  createdAt DateTime @default(now())
  executedAt DateTime?
}

model Ticket {
  id          String         @id @default(cuid())
  number      Int            @unique @default(autoincrement())
  subject     String
  description String
  descriptionHtml String?    @db.Text // Conteúdo HTML do email (quando source='email')
  status      String         @default("OPEN")
  priority    TicketPriority @default(MEDIUM)
  source      String?        // Origem: 'web', 'email', 'whatsapp', 'phone'
  
  // Categoria do chamado
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id])
  
  creatorId   String
  creator     User           @relation("TicketCreator", fields: [creatorId], references: [id])
  
  assigneeId  String?
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  
  // Multi-tenancy
  tenantId    String?
  tenant      Tenant?        @relation(fields: [tenantId], references: [id])
  
  // SLA - prazos calculados na criação
  responseDueAt   DateTime?
  resolutionDueAt DateTime?
  firstResponseAt DateTime?
  
  // Controle de reabertura
  reopenedFlag    Boolean    @default(false)
  reopenedAt      DateTime?
  reopenCount     Int        @default(0)

  // Mesclagem de chamados (chamado origem aponta para o destino)
  mergedIntoId    String?
  mergedInto      Ticket?    @relation("TicketMerge", fields: [mergedIntoId], references: [id])
  mergedFrom      Ticket[]   @relation("TicketMerge")
  mergedAt        DateTime?
  
  // Alerta para o responsável quando há nova interação
  alertAssignee     Boolean    @default(false)
  
  // Integração financeira
  forwardedToFinance Boolean  @default(false)
  financialValue     Decimal? @db.Decimal(12, 2)
  financialNotes     String?
  financialUpdatedAt DateTime?
  financialUpdatedBy String?
  faturado           Boolean  @default(false)
  dataFaturamento    DateTime?
  notaFiscalPath     String?
  rl                 Boolean  @default(false)
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?
  closedAt    DateTime?
  
  // Hora de início e término do serviço (editável pelo técnico ao resolver)
  serviceStartedAt DateTime?
  serviceEndedAt   DateTime?
  
  messages        TicketMessage[]
  attachments     TicketAttachment[]
  processedEmails ProcessedEmail[]
  history         TicketHistory[]
  appointments    Appointment[]
  transferRequests TicketTransferRequest[]
  quotes          Quote[]
  
  @@index([tenantId])
}

// Solicitações de transferência de chamados
model TicketTransferRequest {
  id                          String   @id @default(cuid())
  ticketId                    String
  ticket                      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  currentResponsibleUserId    String
  currentResponsible          User     @relation("TransferCurrentResponsible", fields: [currentResponsibleUserId], references: [id])
  
  requestedNewResponsibleUserId String
  requestedNewResponsible     User     @relation("TransferNewResponsible", fields: [requestedNewResponsibleUserId], references: [id])
  
  requestedByUserId           String
  requestedBy                 User     @relation("TransferRequestedBy", fields: [requestedByUserId], references: [id])
  
  comment                     String?
  status                      String   @default("pending")  // pending, confirmed, rejected, forced, cancelled
  forceTransfer               Boolean  @default(false)
  
  processedByUserId           String?
  processedBy                 User?    @relation("TransferProcessedBy", fields: [processedByUserId], references: [id])
  
  confirmedAt                 DateTime?
  rejectedAt                  DateTime?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  
  @@index([ticketId])
  @@index([requestedNewResponsibleUserId, status])
  @@index([currentResponsibleUserId, status])
}

model TicketMessage {
  id          String   @id @default(cuid())
  content     String
  contentHtml String?  @db.Text  // Conteúdo HTML (quando vem de email)
  bodyClean   String?  @db.Text  // Resposta nova separada (sem histórico citado)
  bodyQuoted  String?  @db.Text  // Histórico citado (quoted reply)
  bodyParseMethod String? @default("raw") // 'parsed', 'raw', 'fallback'
  isInternal  Boolean  @default(false)  // Nota interna ou mensagem para cliente
  
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  authorId  String
  authorName String
  authorRole Role
  
  // Campos técnicos (visíveis apenas para suporte/admin)
  partsUsed      Json?    // Lista de peças utilizadas [{name, qty, value}]
  hoursUsed      Decimal? @db.Decimal(6, 2) // Horas trabalhadas
  visibleToClient Boolean @default(true) // Se false, cliente não vê esta interação
  
  createdAt DateTime @default(now())
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Configurações de Email para Notificações
model EmailConfig {
  id              String   @id @default(cuid())
  key             String   @unique  // Identificador único da configuração
  
  // Multi-tenancy
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  
  // Configurações de contato
  supportEmail    String   // Email do suporte (ti.suporte@wticorp.com.br)
  supportPhone    String?  // WhatsApp de suporte
  
  // Configurações SMTP para envio de emails
  smtpHost        String?  // Ex: smtp.office365.com
  smtpPort        Int?     @default(587)
  smtpUser        String?  // Email de autenticação
  smtpPass        String?  // Senha ou App Password
  smtpSecure      Boolean  @default(false) // true para SSL (465), false para TLS (587)
  smtpFrom        String?  // Email de remetente (pode ser diferente do smtpUser)
  smtpFromName    String?  @default("Winner Tecnologia")
  
  // Configurações IMAP para recebimento de emails (abertura automática de chamados)
  imapEnabled     Boolean  @default(false) // Habilitar abertura de chamados por email
  imapHost        String?  // Ex: outlook.office365.com
  imapPort        Int?     @default(993)
  imapUser        String?  // Email de autenticação (geralmente o mesmo do SMTP)
  imapPass        String?  // Senha (geralmente a mesma do SMTP)
  imapSecure      Boolean  @default(true) // true para SSL (993)
  imapFolder      String?  @default("INBOX") // Pasta a monitorar
  imapProcessed   String?  @default("Processed") // Pasta para mover emails processados
  imapLastCheck   DateTime? // Última verificação de emails
  
  // Microsoft Graph API (alternativa ao IMAP para Office 365)
  graphEnabled    Boolean  @default(false) // Usar Microsoft Graph API
  graphTenantId   String?  // Azure AD Tenant ID
  graphClientId   String?  // Azure AD App Client ID
  graphClientSecret String? // Azure AD App Client Secret
  graphUserEmail  String?  // Email da caixa a monitorar (ex: ti.suporte@wticorp.com.br)
  graphLastCheck  DateTime? // Última verificação de emails
  
  // Notificações ativas
  notifyNewTicket       Boolean @default(true)   // Notificar novo chamado
  notifyTicketUpdate    Boolean @default(true)   // Notificar atualização de status
  notifyNewMessage      Boolean @default(true)   // Notificar nova mensagem
  notifySLAWarning      Boolean @default(true)   // Notificar alerta de SLA
  notifyTicketResolved  Boolean @default(true)   // Notificar chamado resolvido
  notifyTicketClosed    Boolean @default(true)   // Notificar chamado fechado
  
  // Notificações para cliente
  notifyClientNewMessage   Boolean @default(true)  // Cliente recebe nova mensagem
  notifyClientStatusChange Boolean @default(true)  // Cliente recebe mudança de status
  
  // Template de Resposta para Cliente
  templateLogoUrl       String?  // URL do logo no cabeçalho
  templateCompanyName   String?  @default("Winner Tecnologia")
  templatePrimaryColor  String?  @default("#3B82F6") // Azul
  templateSecondaryColor String? @default("#FF6B35") // Laranja
  templateFooterText    String?  @default("Atenciosamente,") // Texto antes da assinatura
  templateSignatureTitle String? @default("Equipe de Suporte") // Cargo/título na assinatura
  templateContactInfo   String?  // Informações de contato no rodapé
  templateShowTicketNumber Boolean @default(true) // Mostrar número do chamado no cabeçalho
  templateShowTechName  Boolean @default(true) // Mostrar nome do técnico na assinatura
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Emails processados para abertura de chamados (evitar duplicação)
model ProcessedEmail {
  id          String   @id @default(cuid())
  messageId   String   @unique // ID único do email (Message-ID header)
  fromEmail   String   // Email do remetente
  subject     String   // Assunto do email
  ticketId    String?  // ID do chamado criado (se houver)
  status      String   @default("processed") // processed, error, ignored
  errorMsg    String?  // Mensagem de erro se falhou
  processedAt DateTime @default(now())
  
  ticket      Ticket?  @relation(fields: [ticketId], references: [id])
}

// Base de Conhecimento - Categorias de Artigos
model KBCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?  @default("FileText")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  
  // Multi-tenancy
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  articles    KBArticle[]
  
  @@index([tenantId])
}

// Base de Conhecimento - Artigos
model KBArticle {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  content     String       // Markdown ou HTML
  excerpt     String?
  isPublished Boolean      @default(false)
  isFeatured  Boolean      @default(false)
  viewCount   Int          @default(0)
  helpfulYes  Int          @default(0)
  helpfulNo   Int          @default(0)
  visibility  KBVisibility @default(PRIVATE) // private = só o autor vê, shared = todos veem
  
  categoryId  String
  category    KBCategory @relation(fields: [categoryId], references: [id])
  
  authorId    String
  authorName  String
  
  // Multi-tenancy
  tenantId    String?
  tenant      Tenant?    @relation(fields: [tenantId], references: [id])
  
  tags        String[]   @default([])
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
  
  @@index([tenantId])
}

// Agendamento de visitas técnicas
model Appointment {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  technicianId  String
  technicianName String
  
  date          DateTime // Data da visita
  startTime     String   // HH:mm
  endTime       String   // HH:mm
  
  observation   String?
  
  companyId       String?  // Empresa do agendamento
  requesterName   String?  // Nome do solicitante
  requesterEmail  String?  // Email do solicitante
  
  // Notificação ao cliente
  notifyClient      Boolean  @default(false) // Enviar email ao salvar
  autoNotify7Days   Boolean  @default(false) // Enviar automaticamente 7 dias antes
  reminderSent      Boolean  @default(false) // Lembrete já enviado
  
  // Multi-tenancy
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  
  createdById   String
  createdByName String
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([technicianId, date, startTime])
  @@index([tenantId])
  @@index([date, autoNotify7Days, reminderSent])
}

// Histórico de alterações de tickets (audit trail)
model TicketHistory {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  action      String   // status_change, assigned, reopened, forwarded_finance, etc
  fromValue   String?  // Valor anterior
  toValue     String?  // Novo valor
  note        String?  // Nota opcional
  
  userId      String
  userName    String
  userRole    Role
  
  createdAt   DateTime @default(now())
}

// ============================================================
// FASE 1 - Monitoramento de Segurança (mini-SIEM)
// ============================================================

model SecurityEvent {
  id        String   @id @default(cuid())
  machineId String
  machine   RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  eventId   Int      // Windows Event ID (4625, 4624, 4672, 4688)
  username  String?
  ipAddress String?
  message   String?
  raw       String?  @db.Text
  timestamp DateTime
  createdAt DateTime @default(now())
  
  @@index([machineId, eventId, timestamp])
  @@index([ipAddress, eventId, timestamp])
}

model SecurityAlert {
  id          String   @id @default(cuid())
  machineId   String
  machine     RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  type        String   // BRUTE_FORCE, PRIVILEGE_ESCALATION, etc.
  severity    String   // LOW, MEDIUM, HIGH, CRITICAL
  description String?  @db.Text
  ipAddress   String?
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime @default(now())
  
  @@index([machineId, type, createdAt])
}

// ============================================================
// FASE 2 - Monitoramento de Rede (SNMP)
// ============================================================

model SnmpDevice {
  id          String       @id @default(cuid())
  name        String
  ipAddress   String       @unique
  community   String       @default("public")
  snmpVersion String       @default("2c") // 2c, 3
  type        String       @default("router") // router, switch, firewall, ap, udm, usw, uap, other
  vendor      String?      // unifi, mikrotik, fortinet, cisco, pfsense, tplink_omada, generic
  model       String?      // Ex: "UDM-Pro", "USW-24-POE", "UAP-AC-Pro"
  macAddress  String?
  firmware    String?
  siteName    String?      @default("default") // UniFi site name
  status      String       @default("unknown") // online, offline, unknown
  lastPoll    DateTime?
  uptimeStr   String?
  latency     Int?         // Última latência em ms
  cpuPercent  Float?       // CPU usage %
  memPercent  Float?       // RAM usage %
  temperature Float?       // Temperatura °C
  
  // UniFi Controller Integration
  controllerUrl     String?  // Ex: https://192.168.1.1
  unifiApiEnabled   Boolean  @default(false)
  controllerUser    String?  // Criptografado
  controllerPass    String?  // Criptografado
  
  // Empresa dona do dispositivo
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id])
  
  // Máquina "vigia" — agente RMM que monitora este dispositivo
  watcherMachineId String?
  watcherMachine   RmmMachine? @relation("DeviceWatcher", fields: [watcherMachineId], references: [id])
  
  // Multi-tenancy
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  
  metrics             SnmpMetric[]
  networkDiagnostics  NetworkDiagnostic[]
  wifiChannelHistory  WifiChannelHistory[]
  switchPortHistory   SwitchPortHistory[]
  wanHealthHistory    WanHealthHistory[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  @@index([tenantId])
  @@index([companyId])
  @@index([watcherMachineId])
  @@index([vendor, type])
}

model SnmpMetric {
  id        String     @id @default(cuid())
  deviceId  String
  device    SnmpDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  metric    String     // bandwidth_in, bandwidth_out, uptime, interface_status, error_count
  value     String
  unit      String?
  createdAt DateTime   @default(now())
  
  @@index([deviceId, metric, createdAt])
}

// ============================================================
// Phase 8 - Diagnóstico de Rede UniFi/SNMP
// ============================================================

model NetworkDiagnostic {
  id              String    @id @default(cuid())
  deviceId        String
  device          SnmpDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  companyId       String?
  severity        String    // info, warning, critical
  category        String    // wifi, switch, gateway, vlan, performance
  diagnosticType  String    // channel_congestion, ap_overloaded, high_retry_rate, wan_packet_loss, port_errors, etc.
  title           String
  description     String    @db.Text
  recommendation  String    @db.Text
  metricValue     String?
  thresholdValue  String?
  isOpen          Boolean   @default(true)
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?   @db.Text
  
  @@index([deviceId, isOpen])
  @@index([companyId, isOpen, severity])
  @@index([diagnosticType, isOpen])
}

model WifiChannelHistory {
  id              String    @id @default(cuid())
  deviceId        String
  device          SnmpDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  radio           String    // 2g, 5g, 6g
  channel         Int?
  channelWidth    Int?      // 20, 40, 80, 160
  txPower         Int?      // dBm
  utilization     Float?    // % channel utilization
  noiseFloor      Int?      // dBm
  clientsCount    Int?
  retryRate       Float?    // %
  satisfaction    Int?      // 0-100
  collectedAt     DateTime  @default(now())
  
  @@index([deviceId, radio, collectedAt(sort: Desc)])
}

model SwitchPortHistory {
  id          String    @id @default(cuid())
  deviceId    String
  device      SnmpDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  portIdx     Int
  portName    String?
  isUp        Boolean?
  speedMbps   Int?
  vlanId      Int?
  poeWatts    Float?
  rxBytes     BigInt?
  txBytes     BigInt?
  rxErrors    BigInt?
  txErrors    BigInt?
  collectedAt DateTime  @default(now())
  
  @@index([deviceId, portIdx, collectedAt(sort: Desc)])
}

model WanHealthHistory {
  id              String    @id @default(cuid())
  deviceId        String
  device          SnmpDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  wanInterface    String    // wan1, wan2
  latencyMs       Float?
  jitterMs        Float?
  packetLossPct   Float?
  rxMbps          Float?
  txMbps          Float?
  ispName         String?
  publicIp        String?
  isPrimary       Boolean   @default(true)
  collectedAt     DateTime  @default(now())
  
  @@index([deviceId, wanInterface, collectedAt(sort: Desc)])
}

// ============================================================
// FASE 3 - Self-Healing (Playbooks)
// ============================================================

model RmmPlaybook {
  id          String              @id @default(cuid())
  name        String
  description String?             @db.Text
  trigger     String              // CPU_HIGH, SERVICE_DOWN, DISK_FULL, RAM_HIGH, CUSTOM
  condition   String?             // JSON: {"threshold": 90, "service": "Spooler"}
  action      String              @db.Text // Script/command to execute
  scriptType  String              @default("powershell")
  enabled     Boolean             @default(true)
  
  // Multi-tenancy
  tenantId    String?
  tenant      Tenant?             @relation(fields: [tenantId], references: [id])
  
  executions  PlaybookExecution[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  
  @@index([tenantId])
}

model PlaybookExecution {
  id         String      @id @default(cuid())
  playbookId String
  playbook   RmmPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  machineId  String
  machine    RmmMachine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  trigger    String
  result     String?     @db.Text
  success    Boolean?
  createdAt  DateTime    @default(now())
  
  @@index([playbookId, createdAt])
  @@index([machineId, createdAt])
}

// ============================================================
// FASE 4 - Integração WhatsApp
// ============================================================

enum WhatsAppGateway {
  META          // API Oficial Meta Business
  EVOLUTION     // Evolution API
  ZAPI          // Z-API
}

model WhatsAppIntegration {
  id            String          @id @default(cuid())
  tenantId      String?
  tenant        Tenant?         @relation(fields: [tenantId], references: [id])
  
  gateway       WhatsAppGateway @default(EVOLUTION)
  instanceName  String?         // Nome da instância
  apiKey        String?         // Chave de API do gateway
  apiUrl        String?         // URL base do gateway (ex: https://api.z-api.io)
  webhookSecret String?         // Segredo para validar webhooks
  phoneNumber   String?         // Número vinculado
  status        String          @default("inactive") // inactive, connecting, connected, error
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  logs          WhatsAppLog[]
  
  @@index([tenantId])
}

model WhatsAppLog {
  id              String   @id @default(cuid())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  
  integrationId   String?
  integration     WhatsAppIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  
  ticketId        String?  // Chamado vinculado (se houver)
  senderPhone     String   // Telefone do remetente
  senderName      String?  // Nome do remetente (se disponível)
  messageBody     String   // Corpo da mensagem
  messageType     String   @default("text") // text, image, document, audio, video
  direction       String   // in = recebido, out = enviado
  externalId      String?  // ID da mensagem no gateway
  
  createdAt       DateTime @default(now())
  
  @@index([tenantId])
  @@index([ticketId])
  @@index([senderPhone, createdAt])
}

// ============================================================
// FASE 3 - Telemetria e Inteligência Operacional
// ============================================================

model SystemEvent {
  id           String   @id @default(cuid())
  type         String   // ticket_created, ticket_updated, ticket_reopened, ticket_closed, status_change, assignee_change, client_reply, internal_note, sla_warning, sla_breached, security_alert
  entityType   String   // ticket, machine, user, company
  entityId     String
  severity     String   @default("info") // info, warning, error, critical
  actorId      String?
  actorName    String?
  metadata     Json?    // dados extras em JSON
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([type])
  @@index([createdAt])
  @@index([severity])
}

// === Conversas IA ===

model AiConversation {
  id        String   @id @default(cuid())
  title     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  messages  AiMessage[]
  
  @@index([userId, updatedAt])
}

model AiMessage {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String   // 'user' | 'assistant'
  content         String   @db.Text
  createdAt       DateTime @default(now())
  
  @@index([conversationId, createdAt])
}

// ============================================================
// ARQUIVO DE CHAMADOS - Sistema legado (N-able / outros)
// Banco SEPARADO dos chamados principais para consulta historica
// ============================================================

model LegacyTicket {
  id              String   @id @default(cuid())
  ticketNumber    String   // numero/identificador do chamado antigo (pode ser String para aceitar formatos diversos)
  requester       String   // solicitante
  company         String   // empresa
  assignee        String?  // responsavel
  ticketDate      DateTime // data do chamado
  description     String   @db.Text   // descricao completa + interacoes (texto concatenado)
  descriptionHtml String?  @db.Text   // versao HTML formatada (quando disponivel)
  status          String?  // status original (aberto/fechado/etc)
  priority        String?  // prioridade original
  category        String?  // categoria original
  rawData         Json?    // dados originais completos para auditoria
  sourceSystem    String   @default("N-ABLE") // N-ABLE, TOMTICKET, OTRS, etc
  importedAt      DateTime @default(now())
  importedBy      String?  // userId de quem importou
  importBatchId   String?  // referencia ao lote de importacao (para desfazer)
  importBatch     LegacyImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([ticketNumber, sourceSystem])
  @@index([ticketDate])
  @@index([company])
  @@index([requester])
  @@index([sourceSystem])
  @@index([importBatchId])
}

// Lote de importacao - permite desfazer importacoes em bloco
model LegacyImportBatch {
  id             String   @id @default(cuid())
  fileName       String
  sourceSystem   String   @default("N-ABLE")
  totalRows      Int      @default(0)
  created        Int      @default(0)  // novos registros criados
  updated        Int      @default(0)  // registros atualizados (nao desfeitos no rollback, apenas os criados)
  skipped        Int      @default(0)
  importedBy     String?  // userId
  importedByName String?  // snapshot do nome para historico
  createdAt      DateTime @default(now())
  undoneAt       DateTime?
  undoneBy       String?

  tickets        LegacyTicket[]

  @@index([createdAt])
  @@index([sourceSystem])
}
// ===== ORCAMENTOS =====
model Quote {
  id              String       @id @default(cuid())
  number          Int          @unique @default(autoincrement())
  title           String
  description     String?      @db.Text
  status          String       @default("DRAFT") // DRAFT, SENT, APPROVED, REJECTED, EXPIRED, CANCELLED, REVISION
  subtotal        Float        @default(0)
  discount        Float        @default(0)   // valor absoluto de desconto
  total           Float        @default(0)
  validUntil      DateTime?
  notes           String?      @db.Text
  rejectionReason String?      @db.Text

  // Revisão solicitada pelo cliente
  revisionReason       String?   @db.Text
  revisionRequestedAt  DateTime?
  revisionRequestedBy  String?   // Nome do usuário que solicitou revisão

  // Emails para quem o orçamento foi enviado
  sentToEmails    String?      @db.Text  // JSON array de emails

  // Quem aprovou/rejeitou
  approvedByName  String?
  rejectedByName  String?
  actionJustification String?  @db.Text  // Justificativa da ação (aprovação/rejeição por admin)

  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ticketId        String?
  ticket          Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  createdBy       String
  createdByName   String
  sentAt          DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           QuoteItem[]

  @@index([status])
  @@index([companyId])
  @@index([ticketId])
  @@index([createdAt])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)
  order       Int      @default(0)

  @@index([quoteId])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  imageUrl    String?
  link        String?
  category    String   @default("Tecnologia")
  author      String   @default("Equipe Winner")
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

model CaseStudy {
  id          String   @id @default(cuid())
  slug        String   @unique
  theme       String
  title       String
  summary     String
  content     String?
  imageUrl    String?
  metrics     Json?
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, order])
}

// ============================================================
// RMM v2 - MÓDULO DE GOVERNANÇA
// Fase 1: Tabelas de Agent Versions, Governance, Relay, Web Filter
// IMPORTANTE: Todas as tabelas são ADITIVAS - zero impacto nas existentes
// ============================================================

// ============================================================
// 1. Controle de Versão do Agente
// ============================================================

model AgentVersion {
  id              String   @id @default(cuid())
  version         String   // Ex: "2.0.1"
  agentType       String   // ps1, msi
  channel         String   @default("stable") // stable, beta, canary
  fileHashSha256  String   // Hash SHA256 do arquivo
  fileSizeBytes   BigInt   // Tamanho em bytes
  downloadUrl     String   // URL para download do agente
  changelog       String?  @db.Text // Notas de versão
  minOsVersion    String?  // Versão mínima do Windows
  isActive        Boolean  @default(true)  // Se disponível para download
  isCritical      Boolean  @default(false) // Update forçado
  createdById     String?  // FK User que publicou
  
  // Multi-tenancy
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  
  updateHistory   AgentUpdateHistory[]
  
  createdAt       DateTime @default(now())
  
  @@unique([version, agentType, channel])
  @@index([agentType, channel, isActive])
  @@index([tenantId])
}

model AgentUpdateHistory {
  id            String    @id @default(cuid())
  machineId     String
  machine       RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  versionId     String?   // FK AgentVersion (versão destino)
  version       AgentVersion? @relation(fields: [versionId], references: [id])
  oldVersion    String?   // Versão anterior (texto livre)
  newVersion    String    // Versão nova
  agentType     String    // ps1, msi
  status        String    @default("pending") // pending, downloading, installing, completed, failed, rolled_back
  errorMessage  String?   @db.Text
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  rollbackAt    DateTime?
  
  @@index([machineId, startedAt(sort: Desc)])
  @@index([status])
}

// ============================================================
// 2. Governança - Produtividade
// ============================================================

model EndpointActivitySession {
  id              String    @id @default(cuid())
  machineId       String
  machine         RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  windowTitle     String    @db.Text
  processName     String    // Ex: "chrome.exe"
  processPath     String?   @db.Text
  category        String?   // productive, neutral, unproductive
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  idleSeconds     Int       @default(0)
  username        String?
  isIdle          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  
  @@index([machineId, startedAt(sort: Desc)])
  @@index([category, startedAt(sort: Desc)])
  @@index([processName, startedAt(sort: Desc)])
}

model WebActivity {
  id              String    @id @default(cuid())
  machineId       String
  machine         RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  url             String    @db.Text
  domain          String    // Ex: "facebook.com"
  pageTitle       String?   @db.Text
  browser         String?   // chrome, edge, firefox
  category        String?   // Categoria do domínio
  durationSeconds Int?
  visitedAt       DateTime
  username        String?
  isBlocked       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  
  @@index([machineId, visitedAt(sort: Desc)])
  @@index([domain, visitedAt(sort: Desc)])
}

// ============================================================
// 3. Governança - Controle USB
// ============================================================

model UsbEvent {
  id            String    @id @default(cuid())
  machineId     String
  machine       RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  deviceId      String    // Hardware ID do dispositivo
  deviceName    String?
  deviceType    String?   // storage, hid, printer, other
  vendorId      String?
  productId     String?
  serialNumber  String?
  action        String    // connected, disconnected, blocked, allowed
  policyApplied String?   // Nome da política aplicada
  username      String?
  eventAt       DateTime
  createdAt     DateTime  @default(now())
  
  @@index([machineId, eventAt(sort: Desc)])
  @@index([action, eventAt(sort: Desc)])
}

model UsbPolicy {
  id            String    @id @default(cuid())
  name          String
  description   String?   @db.Text
  companyId     String?   // NULL = política global
  company       Company?  @relation(fields: [companyId], references: [id])
  policyType    String    // allow, block, read_only, notify
  deviceClass   String?   // Classe: storage, all, etc.
  vendorId      String?
  productId     String?
  serialNumber  String?
  machineIds    String[]  @default([]) // IDs das máquinas específicas (vazio = todas)
  priority      Int       @default(100) // Menor = maior prioridade
  isActive      Boolean   @default(true)
  createdById   String?
  
  // Multi-tenancy
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([companyId, priority])
  @@index([tenantId])
}

// ============================================================
// 4. Governança - Drivers
// ============================================================

model DriverInventory {
  id            String    @id @default(cuid())
  machineId     String
  machine       RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  driverName    String
  driverVersion String?
  provider      String?
  driverDate    DateTime? // Data do driver
  deviceName    String?
  deviceClass   String?
  infName       String?
  isSigned      Boolean?
  signer        String?
  status        String    @default("ok") // ok, warning, error, update_available
  scannedAt     DateTime  @default(now())
  
  updateJobs    DriverUpdateJob[]
  
  @@unique([machineId, infName, driverVersion])
  @@index([machineId])
  @@index([status])
}

model DriverUpdateJob {
  id                String    @id @default(cuid())
  machineId         String
  machine           RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  driverInventoryId String?
  driverInventory   DriverInventory? @relation(fields: [driverInventoryId], references: [id])
  driverName        String
  currentVersion    String?
  targetVersion     String?
  downloadUrl       String?   @db.Text
  status            String    @default("pending") // pending, approved, downloading, installing, completed, failed, cancelled
  approvedById      String?
  errorMessage      String?   @db.Text
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  
  @@index([machineId, createdAt(sort: Desc)])
  @@index([status])
}

// ============================================================
// 5. Governança - Políticas de Produtividade
// ============================================================

model ProductivityPolicy {
  id                      String    @id @default(cuid())
  name                    String
  companyId               String?   // NULL = global
  company                 Company?  @relation(fields: [companyId], references: [id])
  trackApps               Boolean   @default(true)
  trackUrls               Boolean   @default(false)
  trackIdle               Boolean   @default(true)
  idleTimeoutSeconds      Int       @default(300)   // 5 min padrão
  captureIntervalSeconds  Int       @default(30)    // A cada 30s
  workingHoursStart       String?   @default("08:00") // TIME como string
  workingHoursEnd         String?   @default("18:00")
  workingDays             Int[]     @default([1, 2, 3, 4, 5]) // seg-sex
  excludedProcesses       String[]  @default([])
  productiveApps          Json      @default("[]")
  unproductiveApps        Json      @default("[]")
  isActive                Boolean   @default(true)
  createdById             String?
  
  // Multi-tenancy
  tenantId                String?
  tenant                  Tenant?   @relation(fields: [tenantId], references: [id])
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  @@index([companyId])
  @@index([tenantId])
}

// ============================================================
// 6. Governança - Auditoria
// ============================================================

model GovernanceAuditLog {
  id            String    @id @default(cuid())
  action        String    // policy_created, policy_updated, usb_blocked, etc.
  entityType    String    // usb_policy, productivity_policy, etc.
  entityId      String?
  oldValues     Json?
  newValues     Json?
  performedById String?   // FK User
  ipAddress     String?
  userAgent     String?   @db.Text
  createdAt     DateTime  @default(now())
  
  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

// ============================================================
// 7. Relay - Discovery & Deploy
// ============================================================

model RelayDiscoveredMachine {
  id              String    @id @default(cuid())
  relayMachineId  String    // Máquina que fez o discovery
  relayMachine    RmmMachine @relation("RelayScanner", fields: [relayMachineId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id])
  hostname        String?
  ipAddress       String    // IP como string (INET → String)
  macAddress      String?   // MAC address como string
  osInfo          String?
  discoveryMethod String    // arp, ad, ping, netbios, manual
  hasAgent        Boolean   @default(false)
  agentMachineId  String?   // FK RmmMachine se já tem agente
  agentMachine    RmmMachine? @relation("DiscoveredAgent", fields: [agentMachineId], references: [id])
  status          String    @default("discovered") // discovered, pending_approval, approved, deploying, deployed, failed, ignored
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  approvedById    String?
  approvedAt      DateTime?
  notes           String?   @db.Text
  
  deploymentJobs  RelayDeploymentJob[]
  
  @@unique([relayMachineId, ipAddress])
  @@index([relayMachineId, status])
  @@index([companyId, status])
  @@index([status])
}

model RelayDeploymentJob {
  id                  String    @id @default(cuid())
  discoveredMachineId String
  discoveredMachine   RelayDiscoveredMachine @relation(fields: [discoveredMachineId], references: [id], onDelete: Cascade)
  relayMachineId      String    // Máquina relay que executa
  relayMachine        RmmMachine @relation(fields: [relayMachineId], references: [id], onDelete: Cascade)
  deployMethod        String    // psexec, wmi, winrm, psremoting, manual
  agentType           String    @default("msi") // ps1, msi
  agentVersion        String?
  clientToken         String?   // Token do cliente para o agente
  status              String    @default("pending") // pending, queued, transferring, installing, completed, failed, cancelled
  progressPct         Int       @default(0) // 0-100
  errorMessage        String?   @db.Text
  retryCount          Int       @default(0)
  maxRetries          Int       @default(3)
  createdById         String?
  createdAt           DateTime  @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  
  @@index([relayMachineId, status])
  @@index([status])
}

model RelayCredential {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String    // Nome descritivo
  username        String    // Usuário admin
  encryptedPassword String  @db.Text // AES-256 encrypted
  domain          String?   // Domínio AD (opcional)
  credentialType  String    @default("windows") // windows, domain, local
  isActive        Boolean   @default(true)
  lastUsedAt      DateTime?
  createdById     String?
  
  // Multi-tenancy
  tenantId        String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
  
  relayConfigs    RelayConfig[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([companyId])
  @@index([tenantId])
}

model RelayConfig {
  id                  String    @id @default(cuid())
  machineId           String    @unique // FK RmmMachine (1:1)
  machine             RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isRelay             Boolean   @default(false)
  scanIntervalMinutes Int       @default(60)
  scanSubnets         String[]  @default([]) // Subnets a escanear (CIDR)
  scanMethods         String[]  @default(["arp", "ping"])
  autoDeploy          Boolean   @default(false) // Deploy automático sem aprovação
  credentialId        String?
  credential          RelayCredential? @relation(fields: [credentialId], references: [id])
  lastScanAt          DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  @@index([companyId])
}

// ============================================================
// 8. Web Filtering
// ============================================================

model WebFilterCategory {
  id          String    @id @default(cuid())
  name        String    // Ex: "Redes Sociais"
  slug        String    @unique
  description String?   @db.Text
  icon        String?   // Nome do ícone (ex: shield, game)
  isSystem    Boolean   @default(false) // Categorias do sistema (não editáveis)
  parentId    String?   // Hierarquia de categorias
  parent      WebFilterCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    WebFilterCategory[] @relation("CategoryHierarchy")
  
  // Multi-tenancy
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  
  domains     WebFilterCategoryDomain[]
  logs        WebFilterLog[]
  
  createdAt   DateTime  @default(now())
  
  @@index([tenantId])
}

model WebFilterPolicy {
  id                String    @id @default(cuid())
  name              String
  companyId         String?   // NULL = global
  company           Company?  @relation(fields: [companyId], references: [id])
  mode              String    @default("blacklist") // blacklist, whitelist
  blockedDomains    String[]  @default([])
  allowedDomains    String[]  @default([])
  blockedCategories String[]  @default([]) // IDs das categorias bloqueadas
  allowedCategories String[]  @default([])
  blockedKeywords   String[]  @default([])
  machineIds        String[]  @default([]) // IDs das máquinas (vazio = todas da empresa)
  scheduleEnabled   Boolean   @default(false)
  scheduleStart     String?   // TIME como string (HH:mm)
  scheduleEnd       String?
  scheduleDays      Int[]     @default([1, 2, 3, 4, 5])
  blockPageMessage  String?   @default("Acesso bloqueado pela política da empresa.")
  logOnly           Boolean   @default(false) // Apenas registra, não bloqueia
  httpsInspection   Boolean   @default(false) // MITM para HTTPS (avançado)
  safeSearch        Boolean   @default(true)  // Forçar SafeSearch
  priority          Int       @default(100)
  isActive          Boolean   @default(true)
  createdById       String?
  
  // Multi-tenancy
  tenantId          String?
  tenant            Tenant?   @relation(fields: [tenantId], references: [id])
  
  logs              WebFilterLog[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([companyId, priority])
  @@index([tenantId])
}

model WebFilterCategoryDomain {
  id          String    @id @default(cuid())
  categoryId  String
  category    WebFilterCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  domain      String    // Ex: "facebook.com"
  isRegex     Boolean   @default(false) // Se é padrão regex
  source      String    @default("manual") // manual, import, auto, system
  createdAt   DateTime  @default(now())
  
  @@unique([categoryId, domain])
  @@index([domain])
}

model WebFilterLog {
  id          String    @id @default(cuid())
  machineId   String
  machine     RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  policyId    String?
  policy      WebFilterPolicy? @relation(fields: [policyId], references: [id])
  url         String    @db.Text
  domain      String
  categoryId  String?
  category    WebFilterCategory? @relation(fields: [categoryId], references: [id])
  action      String    // blocked, allowed, warned
  reason      String?   // domain_blacklist, category_blocked, keyword_match
  matchedRule String?   @db.Text
  username    String?
  ipAddress   String?
  userAgent   String?   @db.Text
  eventAt     DateTime
  createdAt   DateTime  @default(now())
  
  @@index([machineId, eventAt(sort: Desc)])
  @@index([domain, action, eventAt(sort: Desc)])
  @@index([action, eventAt(sort: Desc)])
}


// ============================================
// RMM v2 - Disk Health Module (Phase 7)
// ============================================

model DiskInventory {
  id            String    @id @default(cuid())
  machineId     String
  machine       RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  
  // Identificação do disco
  diskNumber    Int       // Disk number (0, 1, 2...)
  model         String?   // Modelo do disco (ex: Samsung SSD 970 EVO)
  serialNumber  String?   // Serial number
  firmwareRev   String?   // Firmware revision
  mediaType     String    @default("Unknown") // SSD, HDD, NVMe, Unknown
  busType       String?   // SATA, NVMe, USB, SCSI
  
  // Capacidade e partições
  sizeBytes     BigInt?   // Tamanho total em bytes
  partitionCount Int?     // Número de partições
  partitionsJson String?  @db.Text // JSON [{letter, label, sizeBytes, freeBytes, fileSystem}]
  
  // Status SMART
  smartStatus   String    @default("Unknown") // Healthy, Warning, Critical, Failed, Unknown
  smartEnabled  Boolean?  // Se SMART está ativo
  
  // Timestamps
  lastScanAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relações
  healthMetrics DiskHealthMetric[]
  healthAlerts  DiskHealthAlert[]
  
  @@unique([machineId, diskNumber])
  @@index([machineId])
  @@index([smartStatus])
  @@index([mediaType])
}

model DiskHealthMetric {
  id              String    @id @default(cuid())
  machineId       String
  machine         RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  diskInventoryId String
  diskInventory   DiskInventory @relation(fields: [diskInventoryId], references: [id], onDelete: Cascade)
  
  // Métricas SMART
  temperature     Int?      // Celsius
  powerOnHours    Int?      // Horas ligado
  powerCycleCount Int?      // Contagem de ciclos on/off
  reallocatedSectors Int?   // Setores realocados
  pendingSectors  Int?      // Setores pendentes de realocação
  uncorrectableErrors Int?  // Erros não corrigíveis
  wearLeveling    Int?      // % desgaste (SSD) — 0=novo, 100=esgotado
  
  // Métricas de I/O
  readErrorRate   Int?      // Taxa de erros de leitura
  writeErrorRate  Int?      // Taxa de erros de escrita
  throughputMbps  Float?    // MB/s medido
  
  // SMART raw (completo)
  smartRawJson    String?   @db.Text // JSON completo dos atributos SMART
  
  // Status computado
  healthScore     Int?      // Score 0-100 (calculado pelo agente)
  
  collectedAt     DateTime  @default(now())
  
  @@index([diskInventoryId, collectedAt(sort: Desc)])
  @@index([machineId, collectedAt(sort: Desc)])
  @@index([healthScore])
}

model DiskHealthAlert {
  id              String    @id @default(cuid())
  machineId       String
  machine         RmmMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  diskInventoryId String
  diskInventory   DiskInventory @relation(fields: [diskInventoryId], references: [id], onDelete: Cascade)
  
  // Classificação do alerta
  severity        String    // critical, warning, info
  alertType       String    // temperature_high, smart_failing, reallocated_sectors, wear_critical, disk_full, io_errors
  title           String    // Ex: "Temperatura acima de 60°C"
  description     String?   @db.Text // Detalhes do alerta
  
  // Valores de contexto
  metricName      String?   // Nome da métrica que gerou o alerta
  metricValue     String?   // Valor atual
  thresholdValue  String?   // Limite configurado
  
  // Estado do alerta
  status          String    @default("active") // active, acknowledged, resolved
  acknowledgedBy  String?   // userId que fez acknowledge
  acknowledgedAt  DateTime?
  resolvedBy      String?   // userId que resolveu
  resolvedAt      DateTime?
  resolution      String?   @db.Text // Nota de resolução
  
  createdAt       DateTime  @default(now())
  
  @@index([machineId, status, createdAt(sort: Desc)])
  @@index([severity, status])
  @@index([diskInventoryId])
  @@index([alertType, status])
}